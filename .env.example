# ─────────────────────────────────────────────────────────────────────────────
# Transcript Management System — Environment Variables
# Copy to .env.local for local development.
# In production, set this in Netlify environment variables.
# ─────────────────────────────────────────────────────────────────────────────

# Required — generate with: openssl rand -base64 64
JWT_SECRET=replace_with_at_least_32_random_characters_change_before_deploying

# ─── JWT secret — generate with: ─────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# JWT_SECRET=replace_with_64_random_chars_minimum_32_required
