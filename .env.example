# ─────────────────────────────────────────────────────────────────────────────
# Transcript Management System — Environment Variables
# Copy to .env.local for local development.
# In production, set these in your platform's secrets manager.
# ─────────────────────────────────────────────────────────────────────────────

# Required — generate with: openssl rand -base64 64
JWT_SECRET=replace_with_at_least_32_random_characters_change_before_deploying

# Local Docker Postgres (pnpm db:up) — default credentials match docker-compose.yml
DATABASE_URL=postgresql://postgres:password@localhost:5433/tms_dev

# Optional — used by seed:admin if --email/--password flags are omitted
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_PASSWORD=changeme123
